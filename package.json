  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "theme-ui": ">=0.15.0"
  },
  "devDependencies": {
    "@carbonplan/prettier": "^1.2.0",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.6",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "prettier": "2.5.1",
    "rimraf": "2.6.3",
    "tsup": "^8.5.1",
